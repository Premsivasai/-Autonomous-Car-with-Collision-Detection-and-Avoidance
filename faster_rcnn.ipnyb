        # Import required libraries
        from detectron2.config import get_cfg
        from detectron2.model_zoo import get_config_file, get_checkpoint_url
        from detectron2.engine import DefaultPredictor

        # Load configuration and weights properly
        cfg = get_cfg()
        cfg.merge_from_file(get_config_file("COCO-Detection/faster_rcnn_R_50_FPN_3x.

          ↪yaml"))
        cfg.MODEL.ROI_HEADS.SCORE_THRESH_TEST = 0.5 # Set detection threshold
        cfg.MODEL.WEIGHTS = get_checkpoint_url("COCO-Detection/faster_rcnn_R_50_FPN_3x")

        # Initialize the model predictor
        predictor = DefaultPredictor(cfg)

        print("￿ Model loaded successfully!")

